// ========================================
// Nextflow Configuration - Parallelized for 32 CPU VM
// ========================================

// DSL2
nextflow.enable.dsl = 2

// ========================================
// Executor - Local with Parallelization
// ========================================
process.executor = 'local'

// ========================================
// Caching Strategy
// ========================================
process.cache = 'lenient'
resume = true

// ========================================
// File Staging Configuration
// ========================================
process.stageInMode  = 'symlink'
process.stageOutMode = 'copy'

// ========================================
// Default Resources
// ========================================
process.cpus   = 1
process.memory = '4 GB'
process.time   = '12h'

// ========================================
// Retry Logic
// ========================================
process.errorStrategy = 'retry'
process.maxRetries = 2
process.maxErrors = -1

// ========================================
// Output Directory
// ========================================
params.outdir = params.outdir ?: 'analysis/phewas_prs_nf_out'

// ========================================
// Process-Specific Configuration
// ========================================
process {
  
  // Download processes - no retry needed, fast
  withName: 'DOWNLOAD_.*' {
    cpus   = 1
    memory = '2 GB'
    time   = '1h'
    errorStrategy = 'terminate'
    maxRetries = 0
  }

  withName: FILTER_COUNTS_TO_COHORT {
    publishDir = [ 
      path: "${params.outdir}/inputs/filtered_counts", 
      mode: 'copy', 
      overwrite: true 
    ]
    cpus   = 1
    memory = '6 GB'
    time   = '4h'
    errorStrategy = 'retry'
    maxRetries = 2
  }

  withName: PREPARE_PRS_COHORTS {
    publishDir = [ 
      path: "${params.outdir}/inputs", 
      mode: 'copy', 
      overwrite: true 
    ]
    cpus   = 2
    memory = '16 GB'  // Increased for large PRS matrix
    time   = '12h'
    errorStrategy = 'retry'
    maxRetries = 2
  }

  // ========================================
  // CRITICAL: PheWAS Parallelization
  // ========================================
  withName: RUN_PHEWAS {
    publishDir = [
      path: "${params.outdir}/results",
      mode: 'copy',
      overwrite: true
    ]
    
    // Resource allocation per PheWAS job
    cpus   = 1
    memory = '8 GB'
    time   = '24h'
    
    // KEY: Run up to 20 PheWAS jobs in parallel
    // With 32 CPUs and 208 GB RAM:
    //   - 20 jobs × 1 CPU = 20 CPUs used
    //   - 20 jobs × 8 GB = 160 GB used
    //   - Leaves 12 CPUs and 48 GB for system/overhead
    maxForks = 20
    
    errorStrategy = 'retry'
    maxRetries = 3
  }

  withName: CUSTOM_PLOT {
    publishDir = [ 
      path: "${params.outdir}/plots", 
      mode: 'copy', 
      overwrite: true 
    ]
    cpus   = 1
    memory = '4 GB'
    time   = '2h'
    errorStrategy = 'retry'
    maxRetries = 2
    
    // Allow some parallel plotting (fast tasks)
    maxForks = 8
  }
}

// ========================================
// Execution Reporting
// ========================================
trace {
  enabled = true
  file = "${params.outdir}/trace.txt"
  overwrite = true
  fields = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,%cpu,rss,vmem,peak_rss,peak_vmem'
}

timeline {
  enabled = true
  file = "${params.outdir}/timeline.html"
  overwrite = true
}

report {
  enabled = true
  file = "${params.outdir}/report.html"
  overwrite = true
}

dag {
  enabled = true
  file = "${params.outdir}/dag.svg"
  overwrite = true
}

// ========================================
// Pipeline Parameters
// ========================================
params {

  // ========================================
  // Required Input Files
  // ========================================
  
  prs_matrix = 'gs://fc-secure-c2a3ec74-f528-4692-a6c3-00d9f1946f4c/urvashi_analysis/01.ukb_v20/02.prs_output/00.Adiposity/prs_merged/prs_matrix_ALL_TRAITS.tsv'
  cohort_covariates = 'gs://fc-secure-c2a3ec74-f528-4692-a6c3-00d9f1946f4c/GWAS_core/aou_phewas_nf_files/rs2925979_cohort_with_covariates.tsv'
  phecode_counts = 'gs://fc-secure-c2a3ec74-f528-4692-a6c3-00d9f1946f4c/GWAS_core/aou_phewas_nf_files/aou_phecode_counts.tsv'
  exclude_ids = 'gs://fc-secure-c2a3ec74-f528-4692-a6c3-00d9f1946f4c/GWAS_core/aou_wgs_individual_qc_v8_20260130/exclude_fid_iid.tsv'

  // ========================================
  // PRS Trait Selection
  // ========================================
  prs_traits = 'ALL'
  
  // ========================================
  // Ancestry Selection
  // ========================================
  ancestry_select = 'POOLED'

  // ========================================
  // Cohort Configuration
  // ========================================
  stratify_by_ancestry = true
  ancestry_col         = 'genetic_ancestry'
  person_id_col        = 'person_id'

  // ========================================
  // INT Transform Settings
  // ========================================
  int_seed      = 1
  int_jitter_sd = 1e-12

  // ========================================
  // PheWAS Settings
  // ========================================
  phecode_version     = '1.2'
  min_cases           = 50
  min_phecode_count   = 2
  
  // ========================================
  // Plot Settings
  // ========================================
  converged_only        = true
  label_count           = 15
  
  plot_global_font_size = 14
  plot_fig_width        = 12
  plot_fig_height       = 8
  plot_axis_text_size   = 14
  plot_title_text_size  = 18
  plot_label_size       = 10
  plot_legend_size      = 10
  plot_dpi              = 150
}