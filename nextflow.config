// ========================================
// Nextflow Configuration - Updated
// ========================================

// DSL2
nextflow.enable.dsl = 2

// Executor (local for now - will update to google-batch later)
process.executor = 'local'

// ========================================
// ISSUE 8 FIX: Caching Strategy
// ========================================
// Enable caching to allow resume on failure
process.cache = 'lenient'  // Lenient: ignore timestamps, use content hash

// Allow resume from failed runs
resume = true

// ========================================
// File Staging Configuration
// ========================================
// Avoid copying huge TSVs into each task dir when possible
process.stageInMode  = 'symlink'
process.stageOutMode = 'copy'

// ========================================
// Default Resources
// ========================================
process.cpus   = 1
process.memory = '4 GB'
process.time   = '12h'

// ========================================
// ISSUE 6 FIX: Retry Logic
// ========================================
process.errorStrategy = 'retry'
process.maxRetries = 2
process.maxErrors = '-1'  // Don't stop workflow on individual task failures

// ========================================
// Output Directory
// ========================================
params.outdir = params.outdir ?: 'analysis/phewas_prs_nf_out'

// ========================================
// Process-Specific Configuration
// ========================================
process {
  
  // Download processes - no retry needed, fast
  withName: 'DOWNLOAD_.*' {
    cpus   = 1
    memory = '2 GB'
    time   = '1h'
    errorStrategy = 'terminate'  // Fail fast if downloads fail
    maxRetries = 0
  }

  withName: FILTER_COUNTS_TO_COHORT {
    publishDir = [ 
      path: "${params.outdir}/inputs/filtered_counts", 
      mode: 'copy', 
      overwrite: true 
    ]
    cpus   = 1
    memory = '6 GB'
    time   = '4h'
    errorStrategy = 'retry'
    maxRetries = 2
  }

  withName: PREPARE_PRS_COHORTS {
    publishDir = [ 
      path: "${params.outdir}/inputs", 
      mode: 'copy', 
      overwrite: true 
    ]
    cpus   = 2
    memory = '12 GB'
    time   = '12h'
    errorStrategy = 'retry'
    maxRetries = 2
  }

  withName: RUN_PHEWAS {
    publishDir = [ 
      path: "${params.outdir}/results", 
      mode: 'copy', 
      overwrite: true 
    ]
    cpus   = 1
    memory = '8 GB'
    time   = '24h'
    
    // ISSUE 6: Retry logic for PheWAS failures
    errorStrategy = 'retry'
    maxRetries = 3  // PheWAS can fail due to convergence - retry up to 3 times
    
    // Alternative: ignore failures and continue
    // errorStrategy = { task.exitStatus in [0,1] ? 'ignore' : 'retry' }
  }

  withName: CUSTOM_PLOT {
    publishDir = [ 
      path: "${params.outdir}/plots", 
      mode: 'copy', 
      overwrite: true 
    ]
    cpus   = 1
    memory = '4 GB'
    time   = '2h'
    errorStrategy = 'retry'
    maxRetries = 2
  }
}

// ========================================
// Execution Reporting
// ========================================
trace {
  enabled = true
  file = "${params.outdir}/trace.txt"
  overwrite = true  // ADD THIS LINE
  fields = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,%cpu,rss,vmem,peak_rss,peak_vmem'
}

timeline {
  enabled = true
  file = "${params.outdir}/timeline.html"
  overwrite = true  // ADD THIS LINE
}

report {
  enabled = true
  file = "${params.outdir}/report.html"
  overwrite = true  // ADD THIS LINE
}

dag {
  enabled = true
  file = "${params.outdir}/dag.svg"
  overwrite = true  // ADD THIS LINE
}

// ========================================
// Pipeline Parameters
// ========================================
params {

  // ========================================
  // Required Input Files
  // ========================================
  
  // PRS matrix: local path or gs://...
  prs_matrix = 'gs://fc-secure-c2a3ec74-f528-4692-a6c3-00d9f1946f4c/urvashi_analysis/01.ukb_v20/02.prs_output/00.Adiposity/prs_merged/prs_matrix_ALL_TRAITS.tsv'
  
  // Cohort covariates: local path or gs://...
  cohort_covariates = 'gs://fc-secure-c2a3ec74-f528-4692-a6c3-00d9f1946f4c/GWAS_core/aou_phewas_nf_files/rs2925979_cohort_with_covariates.tsv'
  
  // Phecode counts: local path or gs://...
  phecode_counts = 'gs://fc-secure-c2a3ec74-f528-4692-a6c3-00d9f1946f4c/GWAS_core/aou_phewas_nf_files/aou_phecode_counts.tsv'
  
  // ISSUE 7 FIX: Exclusion IDs file
  exclude_ids = 'gs://fc-secure-c2a3ec74-f528-4692-a6c3-00d9f1946f4c/GWAS_core/aou_wgs_individual_qc_v8_20260130/exclude_fid_iid.tsv'

  // ========================================
  // PRS Trait Selection
  // ========================================
  // Which PRS traits to PheWAS:
  //  - comma-separated list, e.g. "Trunk_fat,VAT_fat_BMIadj"
  //  - "ALL" to use all PRS columns except FID/IID
  //  - or a file path with one trait per line
  
  prs_traits = 'Gynoid_fat,Trunk_fat'
  
  // ========================================
  // ISSUE 2 FIX: Ancestry Selection
  // ========================================
  // Ancestry selection for downstream PheWAS runs:
  //   "ALL"       -> pooled + all ancestries found in data
  //   "POOLED"    -> pooled only (no ancestry stratification)
  //   "eur,afr"   -> pooled + only eur and afr cohorts
  //   "eur,afr,pooled" -> explicit control (pooled + eur + afr)
  
  ancestry_select = 'POOLED'

  // ========================================
  // Cohort Configuration
  // ========================================
  stratify_by_ancestry = true
  ancestry_col         = 'genetic_ancestry'
  person_id_col        = 'person_id'

  // ========================================
  // INT Transform Settings
  // ========================================
  int_seed      = 1
  int_jitter_sd = 1e-12

  // ========================================
  // PheWAS Settings
  // ========================================
  phecode_version     = '1.2'
  min_cases           = 50
  min_phecode_count   = 2
  
  
  // ========================================
  // Plot Settings
  // ========================================
  converged_only        = true
  label_count           = 15
  
  plot_global_font_size = 10
  plot_fig_width        = 14
  plot_fig_height       = 10       // Updated to 8
  plot_axis_text_size   = 8      // Increased for readability
  plot_title_text_size  = 10      // Larger title
  plot_label_size       = 8      // Increased label size
  plot_legend_size      = 6      // Larger legend
  plot_dpi              = 150
}